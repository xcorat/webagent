# Optional explicit path to bot configuration YAML
# BOT_CONFIG=../storage/bot.yaml

# Model provider API keys (configure whichever provider model.name uses)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional path to built static UI directory (defaults to ../ui/build or ../ui/dist if present)
# UI_DIST_DIR=../ui/build

# Startup verbosity (0 = quiet, >0 = print resolved config and masked API key prefixes)
# LOG_LEVEL=0
