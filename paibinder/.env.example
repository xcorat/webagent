# Optional explicit path to bot configuration YAML
# BOT_CONFIG=../storage/bot.yaml

# Model provider API keys (configure whichever provider model.name uses)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional comma-separated CORS origins for the Svelte UI
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
